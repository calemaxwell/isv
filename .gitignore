# Dependencies — reinstalled per platform
node_modules/

# Next.js build output
.next/
out/
# A truncated .next left behind when the workspace mount refused an unlink
# mid-build. Generated output either way, and the directory cannot be
# removed from inside the sandbox.
.nv/
next-env.d.ts
*.tsbuildinfo

# Lockfile is regenerated per platform on purpose. A lockfile written on
# Linux breaks npm's optional platform binaries (lightningcss, @next/swc)
# when the project is then installed on macOS. See portal/README.md.
package-lock.json

# Local scratch
tmp/
.env*.local

# macOS
.DS_Store
