{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".nextv/types/**/*.ts",
    ".nextverify/types/**/*.ts",
    ".nv/types/**/*.ts",
    ".nvb/types/**/*.ts",
    ".nvc/types/**/*.ts",
    "/tmp/isvbuild/types/**/*.ts",
    "/tmp/isvdev/types/**/*.ts",
    "/tmp/isvdev2/types/**/*.ts",
    "/tmp/isvdev3/types/**/*.ts",
    "/tmp/isvverify/types/**/*.ts",
    "next-env.d.ts",
    "/tmp/isv-build/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
